{
  "name": "kesa-messenger",
  "version": "1.0.0",
  "description": "KESA glass-style online messenger",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "space.kesa.messenger",
    "productName": "KESA",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "client/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
